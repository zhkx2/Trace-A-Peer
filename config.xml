<?xml version='1.0' encoding='utf-8'?>
<widget id="com.itcc41.traceapeer" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Trace-a-peer</name>
    <description>An SMS-Based Peer-to-Peer Location Tracking Mobile Application</description>
    <author email="admin@traceapeer.local" href="https://cordova.apache.org">ITCC41 Team</author>
    <content src="index.html" />

    <!-- Cordova plugins -->
    <plugin name="cordova-plugin-android-permissions" spec="^1.1.5" />
    <plugin name="cordova-plugin-device-orientation" spec="^3.0.0" />
    <plugin name="cordova-plugin-foreground-service" spec="^1.1.3" />
    <plugin name="cordova-plugin-geolocation" spec="^5.0.0">
        <variable name="GPS_REQUIRED" value="true" />
    </plugin>
    <plugin name="cordova-plugin-sms-receive" spec="^2.0.0" />
    <plugin name="cordova-sms-plugin" spec="^1.0.5" />
    <plugin name="cordova-sqlite-storage" spec="^7.0.0" />
    
    <!-- Map Tile and Network Access -->
    <access origin="*" />
    <access origin="https://localhost" />
    <access origin="https://unpkg.com" />
    <access origin="https://*.tile.openstreetmap.org" />
    <access origin="https://*.tile.opentopomap.org" />
    
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <platform name="android">
        <allow-intent href="market:*" />

        <!-- Native OS Permission Declarations -->
        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.SEND_SMS" />
            <uses-permission android:name="android.permission.RECEIVE_SMS" />
            <uses-permission android:name="android.permission.READ_SMS" />
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
            <uses-permission android:name="android.permission.WAKE_LOCK" />
        </config-file>

        <!-- Android 14+ requires the foreground service to declare its type -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/service[@android:name='com.davidbriglio.foreground.ForegroundService']">
            <service android:foregroundServiceType="location" />
        </edit-config>
    </platform>
</widget>