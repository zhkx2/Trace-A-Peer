{
  "name": "trace-a-peer",
  "version": "1.0.0",
  "private": true,
  "description": "Offline SMS-based location tracking app",
  "devDependencies": {
    "cordova": "13.0.0",
    "cordova-android": "15.1.0",
    "cordova-plugin-device-orientation": "3.0.0",
    "cordova-plugin-geolocation": "5.0.0",
    "cordova-sms-plugin": "1.0.5",
    "cordova-sqlite-storage": "7.0.0"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-device-orientation": {},
      "cordova-plugin-geolocation": {
        "GPS_REQUIRED": "true"
      },
      "cordova-sms-plugin": {},
      "cordova-sqlite-storage": {}
    }
  }
}
